{
  "name": "colorl",
  "main": "worker.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {"binding": "DB", "database_name": "colorl"}
  ],
  "ratelimits": [
    {"name": "AUTH_LIMIT", "namespace_id": "1001", "simple": {"limit": 25, "period": 60}}
  ]
}
